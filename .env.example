APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/ai_video_studio
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=alloy
AI_PROVIDER=openai
DEFAULT_MAX_PROJECT_BUDGET=5.00
DEFAULT_MAX_WAIT_MINUTES=20
ESTIMATED_TEXT_USD_PER_1K_TOKENS=0.002
ESTIMATED_IMAGE_USD_PER_IMAGE=0.04
ESTIMATED_SPEECH_USD_PER_1K_CHARACTERS=0.015
STUDIO_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ESTIMATED_TRANSCRIPTION_USD_PER_MINUTE=0.006
LOCAL_ANIMATION_LICENSE_ACCEPTED=
# Optional isolated worker overrides. Empty acceptance keeps local generation disabled.
# LOCAL_ANIMATION_PYTHON=C:\path\to\workers\local_animation\.venv\Scripts\python.exe
# LOCAL_ANIMATION_MODEL_DIR=C:\path\to\workers\local_animation\model
